# Zmień nazwę tego pliku na .env i uzupełnij poniższe wartości

# Klucz API z platformy OpenAI
OPENAI_API_KEY="sk-..."

# Klucze VAPID do powiadomień push (wygeneruj je, uruchamiając: python backend/push_notifications.py)
VAPID_PRIVATE_KEY="..."
VAPID_PUBLIC_KEY="..."

# Adres email do kontaktu w nagłówkach VAPID
VAPID_EMAIL="mailto:twoj-email@example.com"
